# Copy this file to ".env" and fill in real values. Never commit the real .env file.

# Groq (https://console.groq.com/keys) — optional after refactor
GROQ_API_KEY=your_groq_api_key_here
# Optional comma-separated fallback keys. The first key is used first.
# GROQ_API_KEYS=first_key,second_key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.1
# Maximum response size. Increase if reports contain many events or actions.
GROQ_MAX_OUTPUT_TOKENS=3000

# Threat Intelligence Providers
# AbuseIPDB (https://www.abuseipdb.com/ — free tier available)
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here
# AlienVault OTX (https://otx.alienvault.com/ — free tier available)
OTX_API_KEY=your_otx_api_key_here

# ChromaDB (local persistent store, no server needed by default)
CHROMA_PERSIST_DIR=./data/chroma_store
CHROMA_COLLECTION_ATTACK=attack_techniques
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Neo4j (run via Docker - see INSTALLATION_GUIDE.md)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# MITRE ATT&CK
ATTACK_DATA_PATH=./data/attack_data/enterprise_attack.json

# Telemetry
RAW_LOGS_DIR=./data/raw_logs
SAMPLE_EVENTS_DIR=./data/sample_events

# Wazuh Connector (Docker integration)
WAZUH_API_URL=https://localhost:55000
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASSWORD=
WAZUH_ALERTS_PATH=/app/data/wazuh_logs/alerts.json  # Docker volume path
WAZUH_POLL_INTERVAL=30
WAZUH_VERIFY_SSL=false

# Reporting
REPORTS_OUTPUT_DIR=./reports/generated_reports

# Response / Action Layer
AUTO_RESPONSE_ENABLED=false
DRY_RUN=true

# Deterministic response risk policy. Automatic execution requires a score
# strictly greater than AUTO_RISK_THRESHOLD. Keep AUTO_EXECUTE_ACTIONS empty
# until remote execution has been tested end-to-end in DRY_RUN mode.
AUTO_RISK_THRESHOLD=80
AUTO_EXECUTE_ACTIONS=
ANALYST_NOTIFICATION_TARGET=SOC_analyst
MAX_AUTO_ACTIONS_PER_TARGET_PER_HOUR=3
RISK_SCORE_VERSION=1.0

# Risk weights (total possible score: 100)
RISK_WEIGHT_SEVERITY_LOW=5
RISK_WEIGHT_SEVERITY_MEDIUM=15
RISK_WEIGHT_SEVERITY_HIGH=25
RISK_WEIGHT_TECHNIQUE_CONFIDENCE=20
RISK_POINTS_PER_FAILED_LOGIN=3
RISK_MAX_REPETITION_POINTS=15
RISK_WEIGHT_SUCCESS_AFTER_FAILURE=20
RISK_WEIGHT_MALICIOUS_IOC=15
RISK_MALICIOUS_IOC_MIN_CONFIDENCE=0.8
RISK_WEIGHT_CAMPAIGN_CONFIDENCE=5

# Safe-mode guardrails / protected assets
# Management source IP (your control host) that must never be blocked/flagged.
MANAGEMENT_SOURCE_IP=
# Comma-separated management IPs that are never treated as malicious IOCs.
PROTECTED_MANAGEMENT_IPS=
# Comma-separated hostnames (e.g. control nodes) that are never isolated/acted against.
PROTECTED_TARGET_HOSTS=

# Remote Response Agent (Machine 2 - push mode)
# URL of the Remote Response Agent running on the target machine
REMOTE_AGENT_URL=
# API key for authenticating with the remote agent
REMOTE_AGENT_API_KEY=change-me-in-production
# Set to true to automatically push generated scripts to the remote agent
REMOTE_AGENT_ENABLED=false
# Timeout (seconds) for remote script execution
REMOTE_AGENT_TIMEOUT=3600
# HMAC-SHA256 shared secret for payload signing (REQUIRED for production)
# Must be the same on Machine 1 and Machine 2. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
REMOTE_AGENT_HMAC_SECRET=
