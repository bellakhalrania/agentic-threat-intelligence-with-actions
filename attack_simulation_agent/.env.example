# Start safely: this produces an event but never invokes Hydra.
ATTACK_TYPE=ssh_bruteforce
TARGET=192.0.2.20
USERNAME=lab_test_user
APPROVED_TARGETS=192.0.2.20
DRY_RUN=true

# Live runs require both settings below. Keep the candidate file lab-only.
ALLOW_LIVE_ATTACKS=false
ATTACK_PASSWORD_FILE_HOST=./passwords.txt
MAX_ATTEMPTS=3
MAX_DURATION_SECONDS=60
MAX_PARALLEL_TASKS=1
SSH_PORT=22

# Optional Machine 3 endpoint, normally http(s)://MACHINE_3:PORT/agent/events
ATTACK_EVENT_WEBHOOK_URL=
ATTACK_EVENT_WEBHOOK_KEY=
ATTACK_EVENT_WEBHOOK_VERIFY_SSL=true
